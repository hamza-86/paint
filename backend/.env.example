# ============================================================
# Paint Shop Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ──────────────────────────────────────────────────
# Local development only. The admin seed requires NODE_ENV=production and an
# explicit production database name in MONGODB_URI; production sets this value
# separately in the hosting platform.
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/paintshop_dev
# Automated tests must use a separate database whose name ends in _test.
MONGODB_TEST_URI=mongodb://localhost:27017/paintshop_test

# ── JSON Web Token ───────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1d
# Number of days the auth cookie stays valid
JWT_COOKIE_EXPIRES_DAYS=1

# ── Cloudinary ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── CORS ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Initial Admin Seed ───────────────────────────────────────
# Used by: npm run seed:admin. Run the seed only with NODE_ENV=production and
# a verified production MONGODB_URI; paintshop_dev and paintshop_test are rejected.
# Set these before running the seed script. Remove after seeding if desired.
ADMIN_EMAIL=admin@paintshop.com
ADMIN_PASSWORD=changeme123

# ── Email / OTP Delivery ─────────────────────────────────────────────────────
# Required for the admin email-change and password-change OTP flows.
# For Gmail: generate an App Password at myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on your Google account).
# The App Password is a 16-char code — use it as EMAIL_PASS, NOT your real password.
#
# Alternatively use a transactional email service such as Brevo, SMTP2GO, or Resend.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_FROM="Paint Shop <your-gmail-address@gmail.com>"
