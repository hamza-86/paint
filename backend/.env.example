# ============================================================
# Paint Shop Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# ── Server ───────────────────────────────────────────────────
# Port the Express server listens on (Render sets this automatically).
PORT=5000

# Node environment: development | production
NODE_ENV=development

# ── MongoDB ──────────────────────────────────────────────────
# MongoDB Atlas connection string (or a local URI for development).
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/paintshop?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string_here

# ── JSON Web Token ───────────────────────────────────────────
# Strong random secret used to sign and verify JWTs.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# ── Cloudinary ───────────────────────────────────────────────
# Find these in Cloudinary Dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── CORS ─────────────────────────────────────────────────────
# The URL of your frontend app (Next.js).
# Local dev: http://localhost:3000
# Production: https://your-frontend.vercel.app (or wherever it's deployed)
FRONTEND_URL=http://localhost:3000
