# ============================================================
# Paint Shop Painter Management Platform — Frontend Environment Variables
# ============================================================
# Copy this file to .env.local for local development.
# ============================================================

# ── BFF (Backend-For-Frontend) target URL ────────────────────────────────────
#
# BACKEND_API_URL  (preferred, server-only)
#   Used exclusively by the Next.js BFF route handler (app/api/backend/[...path]/route.js).
#   Because this variable has no NEXT_PUBLIC_ prefix, it is NEVER sent to the browser.
#   Set this to the Render backend base path (without trailing slash).
#
# NEXT_PUBLIC_API_URL  (legacy fallback)
#   Kept for backward compatibility. The BFF prefers BACKEND_API_URL when both are set.
#   Unlike BACKEND_API_URL, this variable is embedded in the client bundle at build time.
#
# For local development, always point to the LIVE Render backend:
BACKEND_API_URL=https://paint-shop-backend-xgjz.onrender.com/api

# Legacy fallback — only needed if BACKEND_API_URL is not set.
# NEXT_PUBLIC_API_URL=https://paint-shop-backend-xgjz.onrender.com/api
